{
  "name": "coffre",
  "private": true,
  "version": "0.8.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && node scripts/check-design-tokens.mjs && node scripts/check-i18n.mjs",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.ts --project=chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install chromium webkit",
    "core:test": "cargo test --manifest-path src-tauri/Cargo.toml -p coffre-core -p coffre-core-ffi",
    "core:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -p coffre-core -p coffre-core-ffi --all-targets -- -D warnings",
    "extension:build": "vite build --config vite.extension.config.ts && vite build --config vite.content.config.ts && vite build --config vite.webauthn.config.ts",
    "extension:zip": "bun run extension:build && cd dist-extension && zip -qr ../coffre-extension.zip .",
    "extension:smoke": "bun scripts/smoke-extension.mjs",
    "bridge:smoke": "node scripts/smoke-bridge.mjs",
    "icons": "bun run scripts/generate-icons.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "tauri": "tauri",
    "tauri:icons": "tauri icon public/icon.svg",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mobile:android:init": "tauri android init",
    "mobile:android:dev": "tauri android dev",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:dev": "tauri ios dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "aes-js": "^3.1.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/aes-js": "^3.1.4",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "description": "Gestionnaire de mots de passe local-first chiffré, inspiré de Proton Pass"
}
