{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-alias-create",
    "allow-autostart-enabled",
    "allow-autostart-set",
    "allow-autotype-active-window",
    "allow-autotype-run",
    "allow-backup-copy-current",
    "allow-backup-current-file-id",
    "allow-backup-delete",
    "allow-backup-list",
    "allow-backup-read",
    "allow-backup-status",
    "allow-biometric-available",
    "allow-biometric-confirm",
    "allow-biometric-delete",
    "allow-biometric-load",
    "allow-biometric-store",
    "allow-blob-decrypt",
    "allow-blob-encrypt",
    "allow-blob-export-to",
    "allow-blob-import-from",
    "allow-blob-list",
    "allow-blob-preview",
    "allow-blob-remove",
    "allow-bridge-key-delete",
    "allow-bridge-key-load",
    "allow-bridge-key-store",
    "allow-bridge-send",
    "allow-clipboard-clear-if",
    "allow-clipboard-copy-secret",
    "allow-core-merge-files",
    "allow-extension-info",
    "allow-extension-reveal",
    "allow-hibp-range",
    "allow-keychain-delete",
    "allow-keychain-load",
    "allow-keychain-store",
    "allow-lan-discover",
    "allow-lan-forget-peer",
    "allow-lan-identity",
    "allow-lan-pair-join",
    "allow-lan-pair-start",
    "allow-lan-peers",
    "allow-lan-sync-pull",
    "allow-lan-sync-serve",
    "allow-lan-update-peer-host",
    "allow-open-external-url",
    "allow-ssh-agent-respond",
    "allow-ssh-agent-start",
    "allow-ssh-agent-status",
    "allow-ssh-agent-stop",
    "allow-startup-is-hidden",
    "allow-sync-list",
    "allow-sync-prepare",
    "allow-sync-read",
    "allow-sync-unwatch",
    "allow-sync-watch",
    "allow-sync-write",
    "allow-tray-set-keep-on-close",
    "allow-tray-set-language",
    "allow-updater-check",
    "allow-updater-discard",
    "allow-updater-download",
    "allow-updater-info",
    "allow-updater-install",
    "allow-updater-install-on-exit",
