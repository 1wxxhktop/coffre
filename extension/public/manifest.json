{
  "manifest_version": 3,
  "default_locale": "fr",
  "name": "__MSG_extName__",
  "version": "0.8.0",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": [
    "http://localhost:1420/*",
    "http://127.0.0.1:1420/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "menu.js",
        "webauthn-main.js",
        "assets/*",
        "chunks/*",
        "icons/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "coffre@1wxxhktop.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "Coffre",
    "default_popup": "popup.html",
    "default_icon": {
      "192": "icons/icon-192.png",
      "512": "icons/icon-512.png"
    }
  },
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
