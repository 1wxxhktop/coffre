{
  "manifest_version": 3,
  "default_locale": "fr",
  "name": "__MSG_extName__",
  "version": "0.15.0",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "clipboardWrite",
    "clipboardRead",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:1420/*",
    "http://127.0.0.1:1420/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "menu.js",
        "save-banner.html",
        "save-banner.js",
        "webauthn-main.js",
        "assets/*",
        "chunks/*",
        "icons/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "__MSG_commandFillLogin__"
    },
    "generate-password": {
      "description": "__MSG_commandGeneratePassword__"
    },
    "fill-totp": {
      "description": "__MSG_commandFillTotp__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "coffre@1wxxhktop.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Coffre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png",
      "192": "icons/icon-192.png",
      "512": "icons/icon-512.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon-light-16.png",
        "dark": "icons/icon-16.png",
        "size": 16
      },
      {
        "light": "icons/icon-light-32.png",
        "dark": "icons/icon-32.png",
        "size": 32
      },
      {
        "light": "icons/icon-light-48.png",
        "dark": "icons/icon-48.png",
        "size": 48
      },
      {
        "light": "icons/icon-light-128.png",
        "dark": "icons/icon-128.png",
        "size": 128
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
